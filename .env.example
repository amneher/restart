# Copy to .env and adjust for your local setup.
# All values here are the defaults used when .env is absent.

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpassword

# ── Lambda (local dev) ────────────────────────────────────────────────────────
# Set by docker-compose; override here only if running lambda outside Docker.
# WP_BASE_URL=http://localhost:8083

# ── Lambda (staging / prod deploy) ───────────────────────────────────────────
WP_BASE_URL=
WP_PROD_USERNAME=
WP_PROD_APP_PWD=
WP_STAGING_BASE_URL=
WP_STAGING_APP_PWD=
WP_LOCAL_URL=http://localhost:8083
WP_LOCAL_APP_PWD=

# ── AWS ───────────────────────────────────────────────────────────────────────
# Required for make deploy-staging / make deploy-prod.
# In CI these come from GitHub Actions secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
