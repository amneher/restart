{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "palette": [
                { "name": "Primary",  "slug": "primary",  "color": "#47b4b0" },
                { "name": "Dark",     "slug": "dark",     "color": "#193540" },
                { "name": "Accent",   "slug": "accent",   "color": "#ebd060" },
                { "name": "Mid",      "slug": "mid",      "color": "#8a9ea0" },
                { "name": "Mint",     "slug": "mint",     "color": "#9fd4b3" },
                { "name": "Green",    "slug": "green",    "color": "#8ad2a0" },
                { "name": "Base",     "slug": "base",     "color": "#ffffff" }
            ],
            "custom": false
        },
        "typography": {
            "fontFamilies": [
                {
                    "name": "Libre Caslon Display",
                    "slug": "libre-caslon-display",
                    "fontFamily": "'Libre Caslon Display', serif"
                },
                {
                    "name": "Libre Caslon Text",
                    "slug": "libre-caslon-text",
                    "fontFamily": "'Libre Caslon Text', serif"
                },
                {
                    "name": "Montserrat",
                    "slug": "montserrat",
                    "fontFamily": "'Montserrat', sans-serif"
                }
            ],
            "fontSizes": [
                { "name": "Tiny",       "slug": "tiny",       "size": "12px" },
                { "name": "Small",      "slug": "small",      "size": "14px" },
                { "name": "Normal",     "slug": "normal",     "size": "16px" },
                { "name": "Medium",     "slug": "medium",     "size": "22px" },
                { "name": "Large",      "slug": "large",      "size": "32px" },
                { "name": "X-Large",    "slug": "x-large",    "size": "48px" },
                { "name": "XX-Large",   "slug": "xx-large",   "size": "64px" }
            ],
            "customFontSize": true
        },
        "spacing": {
            "units": ["px", "em", "rem", "%", "vw"],
            "spacingSizes": [
                { "name": "X-Small",  "slug": "x-small",  "size": "clamp(10px, 2vw, 20px)" },
                { "name": "Small",    "slug": "small",    "size": "clamp(20px, 4vw, 40px)" },
                { "name": "Medium",   "slug": "medium",   "size": "clamp(30px, 6vw, 60px)" },
                { "name": "Large",    "slug": "large",    "size": "clamp(40px, 8vw, 80px)" },
                { "name": "X-Large",  "slug": "x-large",  "size": "clamp(50px, 10vw, 100px)" }
            ]
        },
        "layout": {
            "contentSize": "780px",
            "wideSize": "1200px"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--mint)",
            "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--libre-caslon-text)",
            "fontSize": "var(--wp--preset--font-size--normal)",
            "lineHeight": "1.7"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--libre-caslon-display)",
                    "fontWeight": "400",
                    "fontSize": "var(--wp--preset--font-size--xx-large)"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--montserrat)",
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--montserrat)",
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--montserrat)",
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            },
            "link": {
                "color": { "text": "var(--wp--preset--color--dark)" },
                ":hover": {
                    "color": { "text": "var(--wp--preset--color--primary)" }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--montserrat)",
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--small)"
                },
                "spacing": {
                    "padding": { "top": "12px", "bottom": "12px", "left": "28px", "right": "28px" }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--dark)",
                        "text": "var(--wp--preset--color--base)"
                    }
                }
            }
        }
    }
}
