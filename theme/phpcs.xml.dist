<?xml version="1.0"?>
<ruleset name="The Restart theme">
    <description>WordPress coding standards for the theme.</description>

    <file>functions.php</file>
    <file>parts</file>
    <file>patterns</file>
    <file>templates</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="ps"/>

    <!-- Formatting / whitespace / docblock style: the codebase uses spaces and
         PSR-style formatting, so only the WordPress correctness and security
         sniffs (escaping, nonces, sanitization, i18n, ...) are enforced. -->
    <rule ref="WordPress">
        <exclude name="Generic.WhiteSpace"/>
        <exclude name="Generic.Formatting"/>
        <exclude name="Generic.Functions"/>
        <exclude name="Generic.ControlStructures.InlineControlStructure"/>
        <exclude name="Generic.Commenting"/>
        <exclude name="PEAR.Functions"/>
        <exclude name="NormalizedArrays.Arrays"/>
        <exclude name="Modernize"/>
        <exclude name="Squiz.Commenting"/>
        <exclude name="Squiz.ControlStructures.ControlSignature"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
        <exclude name="Squiz.PHP.EmbeddedPhp"/>
        <exclude name="Squiz.WhiteSpace"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <exclude name="Universal.WhiteSpace"/>
        <exclude name="WordPress.Arrays"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="WordPress.WhiteSpace"/>
    </rule>
</ruleset>
