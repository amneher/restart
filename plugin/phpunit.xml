<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         defaultTestSuite="default">
    <testsuites>
        <!-- "default" is what runs for bare ./vendor/bin/phpunit (no real-HTTP calls) -->
        <testsuite name="default">
            <directory>tests/unit</directory>
            <directory>tests/integration/Controller</directory>
            <directory>tests/integration/LambdaClient</directory>
        </testsuite>
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/integration/Controller</directory>
            <directory>tests/integration/LambdaClient</directory>
        </testsuite>
        <testsuite name="scraper">
            <directory>tests/integration/Scraper</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>includes</directory>
            <directory>public</directory>
            <directory>admin</directory>
            <directory>mu-plugins</directory>
        </include>
    </source>
</phpunit>
